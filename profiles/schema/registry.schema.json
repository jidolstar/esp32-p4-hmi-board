{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hmi-starter.local/schema/registry.schema.json",
  "title": "HMI profile registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "default_profile",
    "profiles"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "default_profile": {
      "$ref": "#/$defs/profile_id"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    }
  }
}
