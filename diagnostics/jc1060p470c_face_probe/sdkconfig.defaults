CONFIG_IDF_TARGET_ESP32P4=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# 실기기 ESP32-P4 v1.3과 호환되는 image만 생성한다.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

# 제조사 데모와 공식 ESP-DL P4 example의 memory/performance 설정을 따른다.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

# 공식 ESP-DL ESP32-P4 얼굴 예제와 동일하게 3,100바이트 JPEG 작업 풀을 넘지 않는 모드를 쓴다.
CONFIG_JD_USE_ROM=n
CONFIG_JD_FASTDECODE_BASIC=y

# C0.5는 SD/별도 partition 없이 model 포함 비용을 측정한다.
CONFIG_HUMAN_FACE_DETECT_MSRMNP_S8_V1=y
CONFIG_HUMAN_FACE_DETECT_MODEL_IN_FLASH_RODATA=y
CONFIG_HUMAN_FACE_DETECT_MODEL_LOCATION=0
